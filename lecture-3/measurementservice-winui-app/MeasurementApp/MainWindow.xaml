<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MeasurementApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeasurementApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Measurement Service">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#171717" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="40,16">
            <TextBlock
                x:Name="ConnectionText"
                Text="Ansluter…"
                Foreground="#999999" />
        </Border>

        <ScrollViewer Grid.Row="1" Padding="32">
            <ItemsControl ItemsSource="{x:Bind Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="#444444"
                            CornerRadius="14"
                            Padding="30,16"
                            Margin="0,0,0,20">

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Device Id" Foreground="#999999" FontSize="12" />
                                    <TextBlock
                                        Text="{Binding DeviceId}"
                                        Foreground="#ffffff"
                                        FontSize="16" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Last Message" Foreground="#999999" FontSize="12" />
                                    <TextBlock
                                        Text="{Binding LastMessage}"
                                        Foreground="#ffffff"
                                        FontSize="16" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Sending data" Foreground="#999999" FontSize="12" />
                                    <TextBlock
                                        Text="{Binding SendingStatus}"
                                        Foreground="#ffffff"
                                        FontSize="16" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="6">
                                    <TextBlock Text="Status" Foreground="#999999" FontSize="12" />
                                    <TextBlock
                                        Text="{Binding Status}"
                                        Foreground="#ffffff"
                                        FontSize="16" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="4"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    VerticalAlignment="Center">

                                    <Button
                                        Content="START"
                                        Tag="{Binding DeviceId}"
                                        Click="Start_Click"
                                        Background="#087FA5"
                                        Foreground="White" />

                                    <Button
                                        Content="STOP"
                                        Tag="{Binding DeviceId}"
                                        Click="Stop_Click"
                                        Background="#087FA5"
                                        Foreground="White" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
